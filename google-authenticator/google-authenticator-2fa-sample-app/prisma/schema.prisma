generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String       @map("password_hash")
  totpSecret   String?      @map("totp_secret")
  createdAt    DateTime     @default(now()) @map("created_at")

  @@map("users")
}
