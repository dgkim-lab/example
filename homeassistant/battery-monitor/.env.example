HA_URL=http://homeassistant.local:8123
HA_TOKEN=change-me
BATTERY_MONITOR_DEVICE_ID=example-mac
BATTERY_MONITOR_CRON_INTERVAL="*/5 * * * *"

# MQTT mode, requires mosquitto_pub
MQTT_HOST=homeassistant.local
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_DISCOVERY_PREFIX=homeassistant
MQTT_BASE_TOPIC=battery-monitor
MQTT_RETAIN_STATE=true
