# Docker/Compose
GOTOSOCIAL_IMAGE_TAG=latest
POSTGRES_IMAGE_TAG=17-alpine
PUID=10001
PGID=100
TZ=UTC
GTS_PUBLISH_IP=127.0.0.1
GTS_PUBLISH_PORT=8080

# These PUID/PGID defaults match the current local user on this machine.
# If you copy this stack elsewhere, update them to `id -u` and `id -g`.
#
# For a throwaway localhost preview instead, use:
# GTS_HOST=localhost:8080
# GTS_PROTOCOL=http
# GTS_OIDC_ENABLED=false

# Core instance settings
# Set these before the first real startup and do not change them later.
GTS_HOST=social.example.com
GTS_PROTOCOL=https
GTS_BIND_ADDRESS=0.0.0.0
GTS_PORT=8080
GTS_LOG_LEVEL=info
GTS_WAZERO_COMPILATION_CACHE=/gotosocial/.cache

# If you run behind nginx/traefik/caddy, keep built-in letsencrypt disabled.
GTS_LETSENCRYPT_ENABLED=false
GTS_LETSENCRYPT_EMAIL_ADDRESS=
# Example for reverse proxy deployments:
# GTS_TRUSTED_PROXIES=127.0.0.1/32,172.18.0.1/16

# Storage
GTS_STORAGE_BACKEND=local
GTS_STORAGE_LOCAL_BASE_PATH=/gotosocial/storage

# PostgreSQL container
POSTGRES_DB=gotosocial
POSTGRES_USER=gotosocial
POSTGRES_PASSWORD=change-me-now
POSTGRES_INITDB_ARGS=--locale=C.UTF-8 --encoding=UTF8

# GoToSocial -> PostgreSQL connection
GTS_DB_TYPE=postgres
GTS_DB_ADDRESS=postgres
GTS_DB_PORT=5432
GTS_DB_USER=gotosocial
GTS_DB_PASSWORD=change-me-now
GTS_DB_DATABASE=gotosocial
GTS_DB_TLS_MODE=disable
# Optional: if you prefer a single connection string, set this instead;
# GoToSocial will ignore the other DB fields when this is present.
# GTS_DB_POSTGRES_CONNECTION_STRING=postgres://gotosocial:change-me-now@postgres:5432/gotosocial?sslmode=disable

# OIDC login
# GoToSocial supports generic OIDC. Redirect URI must be:
#   https://<GTS_HOST>/auth/callback
# The provider must return a unique non-empty email claim for first login.
GTS_OIDC_ENABLED=false
GTS_OIDC_IDP_NAME=
GTS_OIDC_ISSUER=
GTS_OIDC_CLIENT_ID=
GTS_OIDC_CLIENT_SECRET=
GTS_OIDC_SCOPES=openid,email,profile,groups
GTS_OIDC_LINK_EXISTING=false
# Leave empty to allow any authenticated OIDC user.
GTS_OIDC_ALLOWED_GROUPS=
# Optional admin mapping; expects a "groups" claim from the provider.
GTS_OIDC_ADMIN_GROUPS=

# Example Keycloak values:
# GTS_OIDC_IDP_NAME=Keycloak
# GTS_OIDC_ISSUER=https://sso.example.com/realms/gotosocial
# GTS_OIDC_CLIENT_ID=gotosocial
# GTS_OIDC_CLIENT_SECRET=replace-me
# GTS_OIDC_ADMIN_GROUPS=gotosocial-admins

# Example AWS Cognito values:
# GTS_OIDC_IDP_NAME=AWS Cognito
# GTS_OIDC_ISSUER=https://cognito-idp.ap-northeast-2.amazonaws.com/ap-northeast-2_abcdefgh
# GTS_OIDC_CLIENT_ID=replace-me
# GTS_OIDC_CLIENT_SECRET=replace-me

# Example Google values:
# GTS_OIDC_IDP_NAME=Google
# GTS_OIDC_ISSUER=https://accounts.google.com
# GTS_OIDC_CLIENT_ID=replace-me.apps.googleusercontent.com
# GTS_OIDC_CLIENT_SECRET=replace-me
