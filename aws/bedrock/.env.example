# AWS SDK configuration
AWS_REGION=us-east-1

# Default model IDs used by the hello-world examples.
# Replace these with models that are available and enabled in your account/region.
AMAZON_BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0
ANTHROPIC_BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0

# Prompt sent by ask_amazon / ask-anthropic examples.
PROMPT=Write hello world in Rust lang. Return only the code block.

# CloudWatch usage report window.
USAGE_LOOKBACK_HOURS=24
USAGE_PERIOD_SECONDS=3600
